{
  "name": "github-release-fetcher",
  "version": "1.0.0",
  "description": "A reusable GitHub Action that downloads one release asset (binary or archive) from a specified GitHub repo release.",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "package": "ncc build lib/main.js -o dist --source-map --license licenses.txt",
    "all": "npm run build && npm run package",
    "test": "jest",
    "format": "prettier --write 'src/**/*.ts' '__tests__/**/*.ts'",
    "format-check": "prettier --check 'src/**/*.ts' '__tests__/**/*.ts'",
    "lint": "eslint 'src/**/*.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnitVectorY-Labs/github-release-fetcher.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/UnitVectorY-Labs/github-release-fetcher/issues"
  },
  "homepage": "https://github.com/UnitVectorY-Labs/github-release-fetcher#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.1",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^10.0.1",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
